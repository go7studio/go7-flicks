{
  "name": "go7-flicks",
  "productName": "Go7Flicks",
  "version": "0.1.0",
  "private": true,
  "description": "Local channels, a canvas that starts from a template, and your own API keys. Windows and Mac.",
  "author": "Go7 Studio",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && vite build && remotion bundle src/remotion/index.ts --out-dir remotion-bundle",
    "test": "tsx --test test/*.test.ts",
    "test:cut": "tsx scripts/test-cut.ts",
    "verify:export": "tsx scripts/verify-export.ts",
    "pack:win": "npm run build && electron-builder --win --dir",
    "package:win": "electron-builder --win nsis --publish never",
    "dist:win": "npm run build && npm run package:win",
    "pack:mac": "npm run build && electron-builder --mac --dir --arm64 --publish never",
    "package:mac": "electron-builder --mac dmg --arm64 --publish never",
    "dist:mac": "npm run build && npm run package:mac"
  },
  "dependencies": {
    "@remotion/player": "^4.0.372",
    "@remotion/renderer": "^4.0.372",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "^4.0.372"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.372",
    "@remotion/cli": "^4.0.372",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.go7studio.flicks",
    "productName": "Go7Flicks",
    "copyright": "Copyright © 2026 Go7 Studio",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/@remotion/compositor-*/**",
      "**/node_modules/@remotion/renderer/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "remotion-bundle",
        "to": "remotion-bundle"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "executableName": "Go7Flicks",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Go7Flicks-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Go7Flicks",
      "uninstallDisplayName": "Go7Flicks",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "artifactName": "Go7Flicks-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Go7Flicks reads and writes the channel folders you choose.",
        "NSDesktopFolderUsageDescription": "Go7Flicks uses Desktop folders you choose for channels.",
        "NSDownloadsFolderUsageDescription": "Go7Flicks uses Downloads folders you choose for channels.",
        "NSRemovableVolumesUsageDescription": "Go7Flicks uses external disks you choose for channels.",
        "NSNetworkVolumesUsageDescription": "Go7Flicks uses network folders you choose for channels."
      }
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
